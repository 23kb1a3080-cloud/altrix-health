{
  "name": "altrix-health-copilot",
  "version": "1.0.0",
  "description": "AI-Powered Personal Health Copilot Prototype (ABDM / FHIR R4 Compliant)",
  "type": "module",
  "scripts": {
    "dev": "tsx server/local.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "start": "tsx server/local.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
